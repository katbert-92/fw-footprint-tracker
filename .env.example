# ./fwtrack.sh up writes .env with generated secrets; this is what it holds,
# for setting one up by hand. docker compose reads .env automatically.

BIND_ADDRESS=127.0.0.1

POSTGRES_DB=fwtrack
POSTGRES_USER=fwtrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
# Grafana's own database account, which can only read. Every viewer can send
# the datasource arbitrary SQL, so it must not be the owner's.
GRAFANA_DB_PASSWORD=change-me
# false: a login before any dashboard.
#GRAFANA_ANONYMOUS=true

# Ingest endpoint: what build runners authenticate with. Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FWTRACK_INGEST_TOKEN=change-me
INGEST_PORT=8099

# Used by fwtrack-push and fwtrack-dash to reach the database.
FWTRACK_DSN=postgresql://fwtrack:change-me@localhost:5432/fwtrack

# Uploading dashboards into an already running Grafana (fwtrack-dash --push).
# Not needed for the bundled container: it picks dashboards up from files.
#GRAFANA_URL=https://grafana.example.com
#GRAFANA_TOKEN=glsa_...
