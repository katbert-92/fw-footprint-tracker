# Copy to .env and fill in. docker compose reads this file automatically.

POSTGRES_DB=fwtrack
POSTGRES_USER=fwtrack
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000

# Ingest endpoint: what build runners authenticate with. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FWTRACK_INGEST_TOKEN=change-me
INGEST_PORT=8099
# Version of the package the ingest container installs. Pin to a tag in
# production: main moves under you.
FWTRACK_VERSION=main

# Used by fwtrack-push and fwtrack-dash to reach the database.
FWTRACK_DSN=postgresql://fwtrack:change-me@localhost:5432/fwtrack

# Uploading dashboards into an already running Grafana (fwtrack-dash --push).
# Not needed for the bundled container: it picks dashboards up from files.
#GRAFANA_URL=https://grafana.example.com
#GRAFANA_TOKEN=glsa_...
